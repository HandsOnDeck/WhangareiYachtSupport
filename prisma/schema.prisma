generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum FormType {
  CONTACT
  QUOTE
  ACCOMMODATION
  GUARDIANAGE
  PROJECT
}

enum RecurrenceType {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role      @default(CLIENT)
  billingAddress String?
  marina        String?
  berthNumber   String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  yachts            Yacht[]
  invoices          Invoice[]
  inspectionReports InspectionReport[]
  projects          Project[]
  bookings          AccommodationBooking[]
  formSubmissions   FormSubmission[]
  auditLogs         AuditLog[]
  sentEmails        EmailLog[]         @relation("SentBy")
  recurringInvoices RecurringInvoice[]

  @@index([email])
  @@index([role])
}

model Yacht {
  id         String   @id @default(cuid())
  name       String
  length     String?
  type       String?
  marina     String?
  berthNumber String?
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inspectionReports InspectionReport[]
  projects          Project[]
  invoices          Invoice[]

  @@index([ownerId])
}

model InspectionReport {
  id          String   @id @default(cuid())
  title       String
  summary     String   @db.Text
  content     String   @db.Text
  pdfUrl      String?
  yachtId     String
  yacht       Yacht    @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos Photo[]

  @@index([yachtId])
  @@index([createdAt])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  status      String   @default("active")
  budget      Decimal? @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  yachtId     String
  yacht       Yacht    @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  managerId   String
  manager     User     @relation(fields: [managerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updates ProjectUpdate[]
  photos  Photo[]

  @@index([yachtId])
  @@index([status])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Photo {
  id                 String            @id @default(cuid())
  url                String
  caption            String?
  category           String            @default("general")
  inspectionReportId String?
  inspectionReport   InspectionReport? @relation(fields: [inspectionReportId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())

  @@index([category])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(12, 2)
  gstAmount       Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  notes           String?       @db.Text
  pdfUrl          String?
  sentAt          DateTime?
  viewedAt        DateTime?
  paidAt          DateTime?
  paymentMethod   String?
  stripePaymentId String?
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  yachtId         String?
  yacht           Yacht?        @relation(fields: [yachtId], references: [id])
  recurringId     String?
  recurring       RecurringInvoice? @relation(fields: [recurringId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lineItems InvoiceLineItem[]

  @@index([customerId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  type        String  @default("service")
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model RecurringInvoice {
  id           String         @id @default(cuid())
  name         String
  recurrence   RecurrenceType
  nextDueDate  DateTime
  isActive     Boolean        @default(true)
  customerId   String
  customer     User           @relation(fields: [customerId], references: [id])
  templateData Json
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  invoices Invoice[]

  @@index([customerId])
}

model AccommodationBooking {
  id          String        @id @default(cuid())
  guestName   String
  guestEmail  String
  guestPhone  String?
  guestType   String
  checkIn     DateTime
  checkOut    DateTime
  guests      Int           @default(1)
  notes       String?       @db.Text
  status      BookingStatus @default(PENDING)
  customerId  String?
  customer    User?         @relation(fields: [customerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([checkIn, checkOut])
  @@index([status])
}

model FormSubmission {
  id        String   @id @default(cuid())
  type      FormType
  data      Json
  isRead    Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String   @db.Text
  status    String   @default("sent")
  sentById  String?
  sentBy    User?    @relation("SentBy", fields: [sentById], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  title     String
  category  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  yachtName String
  country   String
  rating    Int      @default(5)
  content   String   @db.Text
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
